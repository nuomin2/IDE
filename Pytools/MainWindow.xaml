<Window x:Class="Pytools.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pytools"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        mc:Ignorable="d"
        Title="My Python IDE" Height="600" Width="1000"
        Background="#F0F0F0">
    <DockPanel>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar HorizontalAlignment="Right" >
                <Button Content="📄 新建" Padding="5,2" Margin="2"/>
                <Button Name="OpenBtn" 
                        Content="📂 打开" 
                        Padding="5,2" 
                        Margin="2"
                        Click="OpenBtn_Click"/>
                <Button Content="💾 保存" Padding="5,2" Margin="2"/>
                <Button Content="▶ 运行" Padding="5,2" Margin="2"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" Height="25" Background="#E0E0E0">
            <StatusBarItem Content="Ready" />
            <Separator />
            <StatusBarItem Content="Python 3.12 (.NET8)" />
        </StatusBar>

        <!-- ======================== 主工作区网格布局 ======================== -->
        <!-- 划分为5列：左侧项目树 | 分割条 | 代码编辑器 | 分割条 | 右侧面板 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <!-- ========= 列0：项目资源管理器 ========= -->
            <Border Grid.Column="0" 
                    Background="#F5F5F5" 
                    BorderBrush="#C0C0C0" 
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <TextBlock Text="项目资源管理器" 
                               DockPanel.Dock="Top" 
                               Margin="5" 
                               FontWeight="Bold" 
                               Foreground="#666"/>
                    <!-- 项目树形视图 -->
                    <TreeView Name="ProjectTreeView"
                              BorderThickness="0" 
                              Background="Transparent"
                              SelectedItemChanged="ProjectTreeView_SelectedItemChanged" Width="135">
                        <TreeViewItem Header="示例项目" IsExpanded="True">
                            <TreeViewItem Header="main.py" />
                        </TreeViewItem>
                    </TreeView>
                </DockPanel>
            </Border>
            <!-- ========= 第1列：垂直分割条（可拖动调整左侧区域宽度） ========= -->
            <GridSplitter Grid.Column="1" 
                          Width="4" 
                          HorizontalAlignment="Stretch" 
                          Background="#DDD"/>
            <!-- ========= 第2列：代码编辑器区域（核心编辑功能） ========= -->
            <Grid Grid.Column="2" Margin="2">
                <Border BorderBrush="#C0C0C0" BorderThickness="1" Background="White">
                    <avalonedit:TextEditor Name="CodeEditor" 
                           FontFamily="Consolas" 
                           FontSize="13"
                           ShowLineNumbers="True" 
                           SyntaxHighlighting="Python"
                           VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
            <!-- ========= 第3列：第二个分割条（透明，可调整右侧面板宽度） ========= -->
            <GridSplitter Grid.Column="3" Width="4" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- ========= 第4列：右侧面板（上下分区） ========= -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <!-- ========= 上行：选项卡控件（变量浏览器 + 调试器） ========= -->
                <TabControl Grid.Row="0" Margin="2">
                    <!-- 变量浏览器选项卡 -->
                    <TabItem Header="Variable Explorer">
                        <!-- DataGrid表格控件：自动生成列，用于显示Python变量信息 -->
                        <DataGrid Name="VariableGrid"
                                  AutoGenerateColumns="True" 
                                  Background="White" 
                                  BorderThickness="0">
                        </DataGrid>
                    </TabItem>
                    <!-- 调试器选项卡（占位，后续扩展） -->
                    <TabItem Header="Debugger" />
                </TabControl>
                
                <!-- ========= 中间行：水平分割条（透明） ========= -->
                <GridSplitter Grid.Row="1" 
                              Height="4" 
                              HorizontalAlignment="Stretch" 
                              Background="Transparent"/>
                
                <!-- ========= 下行：选项卡控件（IPython控制台 + 历史记录） ========= -->
                <TabControl Grid.Row="2" Margin="2">
                    <TabItem Header="IPython Console">
                        <!-- 深色主题的背景 -->
                        <Border Background="#1E1E1E">
                            <!-- 滚动视图包装器 -->
                            <ScrollViewer>
                                <TextBlock Name="ConsoleOutput" 
                                           Foreground="#DCDCDC" FontFamily="Consolas" 
                                           FontSize="12" 
                                           Padding="10"
                                           TextWrapping="Wrap" Text="Python 3.12.1 | Console Ready..." />
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                    <!-- 历史记录选项卡（占位） -->
                    <TabItem Header="History" />
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>

</Window>
