<Window x:Class="Pytools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        xmlns:xcad="https://github.com/Dirkster99/AvalonDock"
        xmlns:xcadTheme="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.Vs2013"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pytools.Views"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:viewmodels="clr-namespace:Pytools.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="720" Width="1200"
        Background="#F0F0F0">
    <DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <ToolBar HorizontalAlignment="Left" >
                <Button Content="📄 新建" Padding="5,2" Margin="2"/>
                <!-- 替换 Click 为 Command 绑定 -->
                <Button Name="OpenFileBtn" Command="{Binding OpenFileCommand}" Padding="5,2" Margin="2">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M13,9V3.5L18.5,9M6,2C4.89,2 4,2.89 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z" 
                              Fill="#555555" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text=" 打开文件" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- 替换 Click 为 Command 绑定 -->
                <Button Name="OpenBtn" 
                        Command="{Binding OpenFolderCommand}"
                        Content="📂 打开文件夹" 
                        Padding="5,2" 
                        Margin="2"/>
                <Button Content="💾 保存" Command="{Binding SaveCommand}" Padding="5,2" Margin="2"/>
                <Button Content="▶ 运行" Padding="5,2" Margin="2"/>
            </ToolBar>
            <!-- 2. 新增：当前文件路径显示区 (贯穿全行) -->
            <Border Background="White" BorderBrush="#DCDCDC" BorderThickness="0,1,0,1" Padding="8,3">
                <StackPanel Orientation="Horizontal">
                    <!-- 左侧小文件夹图标 -->
                    <Path Data="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z" 
                     Fill="#F8D775" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <!-- 路径文本：绑定到 ViewModel 的 ActiveFilePath -->
                    <TextBlock Text="{Binding ActiveFilePath, FallbackValue='未打开任何文件'}" 
                          Foreground="#666666" 
                          VerticalAlignment="Center" 
                          FontSize="11.5"
                          FontFamily="Consolas"/>
                </StackPanel>
            </Border>
        </StackPanel>
        

              

        <!--底部状态栏-->
        <StatusBar DockPanel.Dock="Bottom" Height="25" Background="#E0E0E0">
            <StatusBarItem Content="Python 3.12 (.NET8)" />
        </StatusBar>

        <!-- ======================== 主工作区网格布局 ======================== -->
        <!-- 保持原有5列布局不变 -->
        <xcad:DockingManager x:Name="dockingManager"
                             Background="Transparent"
                             AllowMixedOrientation="True" 
                             VerticalAlignment="Stretch"  
                             HorizontalAlignment="Stretch" 
                             Margin="2">
            <!-- 设置 AvalonDock 的主题，使其融入整体风格 -->
            <xcad:DockingManager.Theme>
                <xcadTheme:Vs2013LightTheme />
            </xcad:DockingManager.Theme>

            <xcad:LayoutRoot>
                <xcad:LayoutPanel Orientation="Horizontal">

                    <!-- ========= 左侧：项目资源管理器 ========= -->
                    <!-- DockWidth 对应你原有的 ColumnDefinition Width="150" -->
                    <xcad:LayoutAnchorablePane DockWidth="150">
                        <xcad:LayoutAnchorable x:Name="ExplorerWindow" Title="项目资源管理器" CanClose="False" CanHide="False" CanAutoHide="False" >
                            
                            <!-- 你的原版 TreeView，ModernWPF 会自动接管其样式 -->
                            <TreeView Name="ProjectTreeView"
                                  BorderThickness="0" 
                                  Background="Transparent"
                                  xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                                  Style="{StaticResource MaterialDesignTreeView}"
                                  SelectedItemChanged="ProjectTreeView_SelectedItemChanged" >
                             <!-- 使用 MDIX 提供的默认辅助样式，会让选中的节点有漂亮的波纹和高亮 -->
                               <TreeView.ItemContainerStyle>
                                 <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                     <Setter Property="Padding" Value="8,4"/>
                                 </Style>
                               </TreeView.ItemContainerStyle>
                            </TreeView>

                        </xcad:LayoutAnchorable>
                    </xcad:LayoutAnchorablePane>

                    <!-- ========= 中间：代码编辑器区域 ========= -->
                    <!-- LayoutDocumentPane 专门用于放置类似代码编辑器的主文档 -->
                    <xcad:LayoutDocumentPane ItemsSource="{Binding Files}" SelectedContent="{Binding SelectedFile, Mode=TwoWay}">
                        <xcad:LayoutDocumentPane.DocumentTitleTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FileName}" />
                            </DataTemplate>
                        </xcad:LayoutDocumentPane.DocumentTitleTemplate>
                        <xcad:LayoutDocumentPane.DocumentContentTemplate>
                            <DataTemplate>
                                <avalonedit:TextEditor FontFamily="Consolas"
                                                       FontSize="13"
                                                       ShowLineNumbers="True"
                                                       SyntaxHighlighting="Python"
                                                       VerticalScrollBarVisibility="Auto"
                                                       Loaded="Editor_Loaded"
                                                       TextChanged="Editor_TextChanged"/>
                            </DataTemplate>
                        </xcad:LayoutDocumentPane.DocumentContentTemplate>
                    </xcad:LayoutDocumentPane>

                    <!-- ========= 右侧：面板区域 ========= -->
                    <!-- DockWidth="400" 大致对应你原有的 Width="4*" 比例 -->
                    <xcad:LayoutPanel Orientation="Vertical" DockWidth="400">

                        <!-- 右侧上方：变量与调试器 (原先的第一个 TabControl) -->
                        <xcad:LayoutAnchorablePane>
                            <xcad:LayoutAnchorable Title="Variable Explorer" CanHide="False" CanAutoHide="False">
                                <!-- 你的 DataGrid，ModernWPF 会自动接管其样式 -->
                                <DataGrid Name="VariableGrid" AutoGenerateColumns="True" 
                                      Background="White" BorderThickness="0"/>
                            </xcad:LayoutAnchorable>
                            <xcad:LayoutAnchorable Title="Debugger" CanHide="False" CanAutoHide="False"/>
                        </xcad:LayoutAnchorablePane>

                        <!-- 右侧下方：控制台与历史 (原先的第二个 TabControl) -->
                        <xcad:LayoutAnchorablePane>
                            <xcad:LayoutAnchorable Title="IPython Console" CanHide="False" CanAutoHide="False">
                                <Border Background="#1E1E1E">
                                    <ScrollViewer>
                                        <TextBlock Name="ConsoleOutput" 
                                               Foreground="#DCDCDC" FontFamily="Consolas" 
                                               FontSize="12" Padding="10" TextWrapping="Wrap" 
                                               Text="{Binding ConsoleText}" />
                                    </ScrollViewer>
                                </Border>
                            </xcad:LayoutAnchorable>
                            <xcad:LayoutAnchorable Title="History" />
                        </xcad:LayoutAnchorablePane>

                    </xcad:LayoutPanel>
                </xcad:LayoutPanel>
            </xcad:LayoutRoot>
        </xcad:DockingManager>
    </DockPanel>
</Window>
