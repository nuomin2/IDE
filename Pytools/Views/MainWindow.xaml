<Window x:Class="Pytools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        ui:WindowHelper.UseModernWindowStyle="True"
        xmlns:xcad="https://github.com/Dirkster99/AvalonDock"
        xmlns:xcadTheme="clr-namespace:AvalonDock.Themes;assembly=AvalonDock.Themes.Vs2013"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pytools.Views"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit"
        xmlns:viewmodels="clr-namespace:Pytools.ViewModels"
        xmlns:converters="clr-namespace:Pytools.Converters"
        xmlns:materialDesign="clr-namespace:MaterialDesignThemes.Wpf;assembly=MaterialDesignThemes.Wpf"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="720" Width="1200"
        Background="#F0F0F0">
    <DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <ToolBar HorizontalAlignment="Left" >
                <Button Content="📄 新建" Command="{Binding NewCommand}" Padding="5,2" Margin="2"/>
                <!-- 替换 Click 为 Command 绑定 -->
                <Button Name="OpenFileBtn" Command="{Binding OpenFileCommand}" Padding="5,2" Margin="2">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M13,9V3.5L18.5,9M6,2C4.89,2 4,2.89 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z" 
                              Fill="#555555" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text=" 打开文件" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- 替换 Click 为 Command 绑定 -->
                <Button Name="OpenBtn" 
                        Command="{Binding OpenFolderCommand}"
                        Content="📂 打开文件夹" 
                        Padding="5,2" 
                        Margin="2"/>
                <Button Content="💾 保存" Command="{Binding SaveCommand}" Padding="5,2" Margin="2"/>
                <Button Content="▶ 运行" Command="{Binding RunCommand}" Padding="5,2" Margin="2"/>
            </ToolBar>
            <!-- 2. 新增：当前文件路径显示区 (贯穿全行) -->
            <Border Background="White" BorderBrush="#DCDCDC" BorderThickness="0,1,0,1" Padding="8,3">
                <StackPanel Orientation="Horizontal">
                    <!-- 左侧小文件夹图标 -->
                    <Path Data="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z" 
                     Fill="#F8D775" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <!-- 路径文本：绑定到 ViewModel 的 ActiveFilePath -->
                    <TextBlock Text="{Binding ActiveFilePath, FallbackValue='未打开任何文件'}" 
                          Foreground="#666666" 
                          VerticalAlignment="Center" 
                          FontSize="11.5"
                          FontFamily="Consolas"/>
                </StackPanel>
            </Border>
        </StackPanel>
        

              

        <!--底部状态栏-->
        <StatusBar DockPanel.Dock="Bottom" Height="25" Background="#E0E0E0">
            <StatusBarItem Content="Python 3.12 (.NET8)" />
        </StatusBar>

        <!-- ======================== 主工作区网格布局 ======================== -->
        <!-- 保持原有5列布局不变 -->
        <xcad:DockingManager x:Name="dockingManager"
                             Background="Transparent"
                             AllowMixedOrientation="True"
                             VerticalAlignment="Stretch"
                             HorizontalAlignment="Stretch"
                             Margin="2">
            <xcad:DockingManager.Theme>
                <xcadTheme:Vs2013LightTheme />
            </xcad:DockingManager.Theme>

            <xcad:LayoutRoot>
                <xcad:LayoutPanel Orientation="Horizontal">

                    <xcad:LayoutAnchorablePane DockWidth="150">
                        <xcad:LayoutAnchorable x:Name="ExplorerWindow" Title="项目资源管理器" CanClose="False" CanHide="False" CanAutoHide="False">
                            <TreeView Name="ProjectTreeView"
                                  BorderThickness="0"
                                  Background="Transparent"
                                  xmlns:md="http://materialdesigninxaml.net/winfx/xaml/themes"
                                  Style="{StaticResource MaterialDesignTreeView}"
                                  SelectedItemChanged="ProjectTreeView_SelectedItemChanged">
                               <TreeView.ItemContainerStyle>
                                 <Style TargetType="TreeViewItem" BasedOn="{StaticResource MaterialDesignTreeViewItem}">
                                     <Setter Property="Padding" Value="8,4"/>
                                 </Style>
                               </TreeView.ItemContainerStyle>
                            </TreeView>
                        </xcad:LayoutAnchorable>
                    </xcad:LayoutAnchorablePane>

                    <xcad:LayoutDocumentPane x:Name="DocumentPane"/>

                    <xcad:LayoutPanel Orientation="Vertical" DockWidth="400">

                        <xcad:LayoutAnchorablePane>
                            <xcad:LayoutAnchorable Title="Variable Explorer" CanHide="False" CanAutoHide="False">
                                <Grid>
                                    <DataGrid Name="VariableGrid"
                                              AutoGenerateColumns="False"
                                              ItemsSource="{Binding VariableList}"
                                              Background="White"
                                              BorderThickness="0"
                                              GridLinesVisibility="None"
                                              HeadersVisibility="Column"
                                              CanUserAddRows="False"
                                              CanUserDeleteRows="False"
                                              CanUserResizeRows="False"
                                              SelectionMode="Single"
                                              RowHeaderWidth="0">
                                        <DataGrid.Style>
                                            <Style TargetType="DataGrid">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VariableList.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </DataGrid.Style>
                                        <DataGrid.Resources>
                                            <converters:ColorToBrushConverter x:Key="ColorToBrush"/>
                                            <Style TargetType="DataGridColumnHeader">
                                                <Setter Property="Background" Value="#FAFAFA"/>
                                                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                                <Setter Property="BorderBrush" Value="#E0E0E0"/>
                                                <Setter Property="Padding" Value="10,4"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                                <Setter Property="FontSize" Value="11"/>
                                            </Style>
                                            <Style TargetType="DataGridCell">
                                                <Setter Property="BorderThickness" Value="0"/>
                                                <Setter Property="Padding" Value="10,2"/>
                                                <Setter Property="FontSize" Value="11"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="DataGridCell">
                                                            <Border Background="{Binding TypeColor, Converter={StaticResource ColorToBrush}}"
                                                                    Padding="{TemplateBinding Padding}">
                                                                <ContentPresenter/>
                                                            </Border>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="80"/>
                                            <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="60"/>
                                            <DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="2*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VariableList.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <materialDesign:PackIcon Kind="Telescope"
                                                                Foreground="#AAAAAA"
                                                                Width="32" Height="32"
                                                                Margin="0,0,0,12"/>
                                        <TextBlock Text="No variables to show"
                                                   FontSize="16"
                                                   Foreground="#888888"
                                                   HorizontalAlignment="Center"
                                                   Margin="0,0,0,6"/>
                                        <TextBlock Text="Run code in the Editor to see global variables listed here."
                                                   FontSize="12"
                                                   Foreground="#AAAAAA"
                                                   HorizontalAlignment="Center"
                                                   TextWrapping="Wrap"
                                                   TextAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </xcad:LayoutAnchorable>
                            <xcad:LayoutAnchorable Title="Debugger" CanHide="False" CanAutoHide="False"/>
                            <xcad:LayoutAnchorable Title="Plot Viewer" CanHide="False" CanAutoHide="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FAFAFA"
                BorderBrush="#E0E0E0" BorderThickness="0,0,0,1" Padding="4,2">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PlotList.Count}" Value="0">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel Orientation="Horizontal">
                <Button Command="{Binding SavePlotCommand}" Padding="4" Margin="4,0,4,0"
                        ToolTip="Save plot as..." Background="Transparent" BorderThickness="0">
                    <materialDesign:PackIcon Kind="ContentSave" Width="14" Height="14" Foreground="#555555"/>
                </Button>
                <Button Command="{Binding SaveAllPlotsCommand}" Padding="4" Margin="0,0,0,0"
                        ToolTip="Save all plots as..." Background="Transparent" BorderThickness="0">
                    <materialDesign:PackIcon Kind="ContentSaveAll" Width="14" Height="14" Foreground="#555555"/>
                </Button>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="85"/>
            </Grid.ColumnDefinitions>

            <Image Grid.Column="0" Source="{Binding SelectedPlot.ImageSource}" Stretch="Uniform" Margin="4"/>

            <ListBox Grid.Column="1" ItemsSource="{Binding PlotList}" SelectedItem="{Binding SelectedPlot, Mode=TwoWay}"
                     Background="#F5F5F5" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     HorizontalContentAlignment="Stretch">
                <ListBox.Resources>
                    <Style TargetType="ScrollBar">
                        <Setter Property="Width" Value="10"/>
                        <Setter Property="MinWidth" Value="10"/>
                    </Style>
                </ListBox.Resources>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                        <Setter Property="Padding" Value="4,4,8,4"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Image Source="{Binding ImageSource}" Stretch="Uniform"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="1" Background="#F5F5F5">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding PlotList.Count}" Value="0">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <materialDesign:PackIcon Kind="ImageArea"
                                         Foreground="#AAAAAA"
                                         Width="32" Height="32"
                                         Margin="0,0,0,12"/>
                <TextBlock Text="No plots to show"
                           FontSize="14"
                           Foreground="#888888"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</xcad:LayoutAnchorable>
                        </xcad:LayoutAnchorablePane>

                        <xcad:LayoutAnchorablePane>
                            <xcad:LayoutAnchorable x:Name="ConsoleAnchorable"
                                                   Title="IPython Console"
                                                   CanHide="False"
                                                   CanAutoHide="False">
                                <Border Background="#1E1E1E">
                                    <ListBox Name="ConsoleListBox"
                                             ItemsSource="{Binding ConsoleLines}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="#DCDCDC"
                                             FontFamily="Consolas"
                                             FontSize="12">
                                        <ListBox.ItemContainerStyle>
                                            <Style TargetType="ListBoxItem">
                                                <Setter Property="Foreground" Value="#DCDCDC"/>
                                                <Setter Property="Padding" Value="10,1"/>
                                                <Setter Property="Template">
                                                    <Setter.Value>
                                                        <ControlTemplate TargetType="ListBoxItem">
                                                            <ContentPresenter/>
                                                        </ControlTemplate>
                                                    </Setter.Value>
                                                </Setter>
                                            </Style>
                                        </ListBox.ItemContainerStyle>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VirtualizingStackPanel/>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </Border>
                            </xcad:LayoutAnchorable>
                            <xcad:LayoutAnchorable Title="History" />
                        </xcad:LayoutAnchorablePane>

                    </xcad:LayoutPanel>
                </xcad:LayoutPanel>
            </xcad:LayoutRoot>
        </xcad:DockingManager>
    </DockPanel>
</Window>
