<Window x:Class="Pytools.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Pytools.Views"
        xmlns:avalonedit="http://icsharpcode.net/sharpdevelop/avalonedit" xmlns:viewmodels="clr-namespace:Pytools.ViewModels" d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
        mc:Ignorable="d"
        Title="{Binding WindowTitle}" Height="720" Width="1200"
        Background="#F0F0F0">
    <Window.Resources>
        <Style x:Key="MatlabTreeViewItemStyle" TargetType="TreeViewItem">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="2,1"/>
            <Setter Property="Margin" Value="0,1,0,1"/>
            <Setter Property="Foreground" Value="#2E2E2E"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#DCEBFF"/>
                    <Setter Property="Foreground" Value="#003A70"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>

        <StackPanel DockPanel.Dock="Top">
            <ToolBar HorizontalAlignment="Left" >
                <Button Content="📄 新建" Padding="5,2" Margin="2"/>
                <!-- 替换 Click 为 Command 绑定 -->
                <Button Name="OpenFileBtn" Command="{Binding OpenFileCommand}" Padding="5,2" Margin="2">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="M13,9V3.5L18.5,9M6,2C4.89,2 4,2.89 4,4V20A2,2 0 0,0 6,22H18A2,2 0 0,0 20,20V8L14,2H6Z" 
                              Fill="#555555" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center"/>
                        <TextBlock Text=" 打开文件" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <!-- 替换 Click 为 Command 绑定 -->
                <Button Name="OpenBtn" 
                        Command="{Binding OpenFolderCommand}"
                        Content="📂 打开文件夹" 
                        Padding="5,2" 
                        Margin="2"/>
                <Button Content="💾 保存" Padding="5,2" Margin="2"/>
                <Button Content="▶ 运行" Padding="5,2" Margin="2"/>
            </ToolBar>
            <!-- 2. 新增：当前文件路径显示区 (贯穿全行) -->
            <Border Background="White" BorderBrush="#DCDCDC" BorderThickness="0,1,0,1" Padding="8,3">
                <StackPanel Orientation="Horizontal">
                    <!-- 左侧小文件夹图标 -->
                    <Path Data="M20,18H4V8H20M20,6H12L10,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V8C22,6.89 21.1,6 20,6Z" 
                     Fill="#F8D775" Stretch="Uniform" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <!-- 路径文本：绑定到 ViewModel 的 ActiveFilePath -->
                    <TextBlock Text="{Binding ActiveFilePath, FallbackValue='未打开任何文件'}" 
                          Foreground="#666666" 
                          VerticalAlignment="Center" 
                          FontSize="11.5"
                          FontFamily="Consolas"/>
                </StackPanel>
            </Border>
        </StackPanel>
        

              

        <!--底部状态栏-->
        <StatusBar DockPanel.Dock="Bottom" Height="25" Background="#E0E0E0">
            <StatusBarItem Content="Python 3.12 (.NET8)" />
        </StatusBar>

        <!-- ======================== 主工作区网格布局 ======================== -->
        <!-- 保持原有5列布局不变 -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="6*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="4*" />
            </Grid.ColumnDefinitions>
            <!-- ========= 列0：项目资源管理器 ========= -->
            <Border Grid.Column="0"
                    Background="#FFFFFF"
                    BorderBrush="#C0C0C0"
                    BorderThickness="0,0,1,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Background="#EAF2FF" BorderBrush="#C9DDFB" BorderThickness="0,0,0,1" Padding="6,5">
                        <TextBlock Text="Current Folder"
                                   FontWeight="Bold"
                                   Foreground="#2A4A7B"/>
                    </Border>
                    <!-- 项目树形视图 -->
                    <TreeView Name="ProjectTreeView"
                              ItemContainerStyle="{StaticResource MatlabTreeViewItemStyle}"
                              BorderThickness="0" 
                              Background="Transparent"
                              SelectedItemChanged="ProjectTreeView_SelectedItemChanged">
                    </TreeView>
                </DockPanel>
            </Border>
            <!-- ========= 第1列：垂直分割条 ========= -->
            <GridSplitter Grid.Column="1" 
                          Width="2" 
                          HorizontalAlignment="Stretch" 
                          Background="#DDD"/>
            <!-- ========= 第2列：代码编辑器区域 ========= -->
            <Grid Grid.Column="2" Margin="2">
                <Border BorderBrush="#C0C0C0" BorderThickness="1" Background="White">
                    <avalonedit:TextEditor Name="CodeEditor" 
                           FontFamily="Consolas" 
                           FontSize="13"
                           ShowLineNumbers="True" 
                           SyntaxHighlighting="Python"
                           VerticalScrollBarVisibility="Auto"/>
                </Border>
            </Grid>
            <!-- ========= 第3列：第二个分割条 ========= -->
            <GridSplitter Grid.Column="3" Width="1" HorizontalAlignment="Stretch" Background="Transparent"/>

            <!-- ========= 第4列：右侧面板 ========= -->
            <Grid Grid.Column="4">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>
                <TabControl Grid.Row="0" Margin="2">
                    <TabItem Header="Variable Explorer">
                        <DataGrid Name="VariableGrid" AutoGenerateColumns="True" Background="White" BorderThickness="0"/>
                    </TabItem>
                    <TabItem Header="Debugger" />
                </TabControl>

                <GridSplitter Grid.Row="1" Height="4" HorizontalAlignment="Stretch" Background="Transparent"/>

                <TabControl Grid.Row="2" Margin="2">
                    <TabItem Header="IPython Console">
                        <Border Background="#1E1E1E">
                            <ScrollViewer>
                                <!-- 绑定到 ViewModel 的 ConsoleText -->
                                <TextBlock Name="ConsoleOutput" 
                                           Foreground="#DCDCDC" FontFamily="Consolas" 
                                           FontSize="12" Padding="10" TextWrapping="Wrap" 
                                           Text="{Binding ConsoleText}" />
                            </ScrollViewer>
                        </Border>
                    </TabItem>
                    <TabItem Header="History" />
                </TabControl>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
